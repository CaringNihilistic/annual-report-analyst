# Copy to .env and fill in. Never commit .env.

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/annual_reports

# LLMs. Groq is the default; the model is configurable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback when Groq's free tier is rate-limited (claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Tracing (optional, not used in M1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ingestion
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
